# 모바일 앱이 호출할 백엔드 API. EXPO_PUBLIC_ 접두사만 앱 번들에 노출된다.
# 실기기에서 테스트할 때 localhost는 기기가 못 찾으므로, 개발 PC의 LAN IP로 바꾼다.
#   예) EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 북로그(/shelf)·북메이트(/community)를 WebView로 띄울 웹(Next.js) 주소.
# 실기기에서 테스트할 때 localhost는 기기가 못 찾으므로, 개발 PC의 LAN IP로 바꾼다.
#   예) EXPO_PUBLIC_WEB_BASE_URL=http://192.168.0.10:3000
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:3000

# 카카오 네이티브 앱 키 (카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > 네이티브 앱 키)
# 설정 후 반드시 `npx expo prebuild --clean` + dev build 필요 (Expo Go 불가).
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=your-kakao-native-app-key
