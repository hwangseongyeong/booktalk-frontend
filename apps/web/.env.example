NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
NEXT_PUBLIC_KAKAO_CLIENT_ID=your-kakao-rest-api-key
NEXT_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/oauth/callback/kakao

# 네이버 개발자센터 > 애플리케이션 등록 > Client ID
NEXT_PUBLIC_NAVER_CLIENT_ID=your-naver-client-id
NEXT_PUBLIC_NAVER_REDIRECT_URI=http://localhost:3000/oauth/callback/naver

# Google Cloud Console > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback/google

# Facebook for Developers > 앱 설정 > 앱 ID
NEXT_PUBLIC_FACEBOOK_CLIENT_ID=your-facebook-app-id
NEXT_PUBLIC_FACEBOOK_REDIRECT_URI=http://localhost:3000/oauth/callback/facebook
